"""Publish a post to the Semia home channel.

Usage:
  python publish.py [--md] [--edit MID] <text or @file or filepath>
  python publish.py --delete MID [MID ...]
Reads chat from .env (SEMA_CHANNEL_ID). Long posts are split into <=4000-char parts.
--md        enables MarkdownV2 parse_mode (for > blockquotes, *bold*, _italic_).
--edit MID  edit message MID in the channel instead of sending a new one.
--delete    delete one or more messages from the channel.
Prints "OK message_id ..." on success, "ERROR ..." on failure (to stderr).
"""
import json, os, sys, urllib.error, urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))

def load_env(path):
    env = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip()
    return env

env = load_env(os.path.join(HERE, ".env"))
TOKEN = env.get("TELEGRAM_BOT_TOKEN", "")
CHAT = env.get("SEMA_CHANNEL_ID", "-1003654061308")
BASE = f"https://api.telegram.org/bot{TOKEN}"

def call(method, params):
    req = urllib.request.Request(BASE + "/" + method,
                                 data=json.dumps(params).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        body = e.read()
        try:
            return json.loads(body)
        except Exception:
            return {"ok": False, "description": body.decode("utf-8", "replace")}
    except Exception as e:
        return {"ok": False, "description": str(e)}

import re

# Characters that must be escaped in MarkdownV2 (outside code blocks)
_MD2_SPECIAL = r"_*[]()~`>#+-=|{}.!"

def _is_boundary(ch):
    return ch in (" ", "\n", "\r", "\t")

def escape_md2(text):
    """Escape MarkdownV2 special characters, preserving intentional formatting."""
    out = []
    i = 0
    while i < len(text):
        ch = text[i]
        # preserve blockquote prefix at line start
        if ch == ">" and (i == 0 or text[i-1] == "\n"):
            out.append(ch)
            i += 1
            continue
        # preserve *bold* and _italic_ markers only when valid delimiters
        if ch in ("*", "_"):
            prev = text[i-1] if i > 0 else ""
            nxt = text[i+1] if i+1 < len(text) else ""
            is_opening = (prev == "" or _is_boundary(prev)) and not (nxt == "" or _is_boundary(nxt))
            is_closing = not (prev == "" or _is_boundary(prev)) and (nxt == "" or _is_boundary(nxt))
            if is_opening or is_closing:
                out.append(ch)
            else:
                out.append("\\" + ch)
            i += 1
            continue
        # escape everything else that is special
        if ch in _MD2_SPECIAL:
            out.append("\\" + ch)
        else:
            out.append(ch)
        i += 1
    return "".join(out)

def split_text(text, n=4000):
    text = text.strip()
    if len(text) <= n:
        return [text]
    parts, cur = [], ""
    for para in text.split("\n\n"):
        if cur and len(cur) + len(para) + 2 > n:
            parts.append(cur.strip())
            cur = para
        else:
            cur = (cur + "\n\n" + para).strip()
    if cur:
        parts.append(cur.strip())
    out = []
    for p in parts:
        while len(p) > n:
            out.append(p[:n])
            p = p[n:]
        out.append(p)
    return out

def main():
    args = sys.argv[1:]
    if "--delete" in args:
        i = args.index("--delete")
        mids = [int(x) for x in args[i+1:]]
        for mid in mids:
            r = call("deleteMessage", {"chat_id": CHAT, "message_id": mid})
            if not r.get("ok"):
                print("ERROR:", mid, r.get("description"), file=sys.stderr)
                sys.exit(1)
        print("OK deleted", ",".join(str(m) for m in mids))
        return
    use_md = "--md" in args
    if use_md:
        args.remove("--md")
    edit_id = None
    if "--edit" in args:
        i = args.index("--edit")
        edit_id = int(args[i + 1])
        del args[i:i + 2]
    reply_to = None
    if "--reply" in args:
        i = args.index("--reply")
        reply_to = int(args[i + 1])
        del args[i:i + 2]
    text = ""
    if args:
        candidate = args[0]
        if os.path.isfile(candidate):
            text = open(candidate, encoding="utf-8").read()
        else:
            text = candidate
    if not text:
        text = sys.stdin.read()
    if not text.strip():
        print("ERROR: empty post", file=sys.stderr)
        sys.exit(1)
    ids = []
    method = "editMessageText" if edit_id else "sendMessage"
    for part in split_text(text):
        if use_md:
            part = escape_md2(part)
        params = {"chat_id": CHAT, "text": part}
        if edit_id:
            params["message_id"] = edit_id
        if use_md:
            params["parse_mode"] = "MarkdownV2"
        if reply_to and not edit_id:
            params["reply_to_message_id"] = reply_to
        r = call(method, params)
        if not r.get("ok"):
            print("ERROR:", r.get("description"), file=sys.stderr)
            sys.exit(1)
        ids.append(str(r["result"]["message_id"]))
    print("OK message_id", ",".join(ids))

if __name__ == "__main__":
    main()